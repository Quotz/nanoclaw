#!/bin/bash
# Nightly backup of everything the older per-app backups don't cover, into
# /root/backups/nightly/<date>/. Existing jobs keep running: twenty-backup,
# taskosaur-backup (root crontab), hindsight-backup. The laptop pulls
# /root/backups + /root/.hermes/hindsight-backups off the box (see bin/ops/README.md).
# Also run by auto-update before any upgrade. DMs only on failure.
set -uo pipefail
KEEP_DAYS=14
DEST=/root/backups/nightly/$(date -u +%Y-%m-%dT%H%MZ)
mkdir -p "$DEST"; cd "$DEST" || exit 1
fail=()
step(){ local name=$1; shift; if ! "$@" 2>>"$DEST/errors.log"; then fail+=("$name"); fi; }

# Databases
step onecli-db  bash -c 'docker exec onecli-postgres-1 pg_dumpall -U onecli | gzip > onecli-db.sql.gz'
step matrix-db  bash -c 'docker exec matrix-postgres pg_dump -U dendrite dendrite | gzip > matrix-db.sql.gz'
step twenty-db  bash -c 'docker exec twenty-db pg_dump -U postgres default | gzip > twenty-db.sql.gz'
step taskosaur-db bash -c 'docker exec taskosaur-postgres pg_dump -U taskosaur taskosaur | gzip > taskosaur-db.sql.gz'
step nanoclaw-db python3 -c 'import sqlite3; s=sqlite3.connect("/opt/nanoclaw/data/v2.db"); d=sqlite3.connect("nanoclaw-v2.db"); s.backup(d); d.close()'

# OneCLI app volume: holds the secret-encryption key and gateway CA (without it the DB dump is useless)
step onecli-volume bash -c 'tar -czf onecli-app-data.tar.gz -C /var/lib/docker/volumes/onecli_app-data/_data .'

# NanoClaw state (sessions, groups, env) and host config
step nanoclaw-files tar -czf nanoclaw-files.tar.gz -C /opt/nanoclaw --exclude=data/v2.db data groups .env
step configs bash -c 'tar -czf configs.tar.gz --ignore-failed-read --exclude=usr/local/bin/uv --exclude=usr/local/bin/uvx --exclude=*.log \
  /opt/twenty/docker-compose.yml /opt/twenty/.env /opt/taskosaur /opt/caddy /opt/matrix/config /opt/matrix/docker-compose.yml \
  /home/nanoclaw/.onecli/.env /home/nanoclaw/.onecli/docker-compose.yml /home/nanoclaw/bin \
  /etc/cron.d /etc/systemd/system/nanoclaw.service /etc/systemd/system/nanoclaw.service.d \
  /etc/systemd/system/hindsight-api.service /etc/systemd/system/twenty-mcp.service /etc/systemd/system/taskosaur-mcp.service \
  /etc/twenty-mcp /etc/taskosaur-mcp /etc/hindsight /usr/local/bin /usr/local/lib/mcp-smoke.mjs /root/.config/ops-claude \
  /home/hermes/.hermes/config.yaml /home/hermes/.hermes/.env /home/hermes/.hermes/SOUL.md /home/hermes/.hermes/hindsight 2>/dev/null; [ -s configs.tar.gz ]'

chmod -R go-rwx "$DEST"
find /root/backups/nightly -mindepth 1 -maxdepth 1 -type d -mtime +$KEEP_DAYS -exec rm -rf {} +

if [ ${#fail[@]} -gt 0 ]; then
  echo "$(date -u +%FT%TZ) FAIL ${fail[*]} -> $DEST"
  /usr/local/bin/matrix-dm "⚠️ Nightly backup had failures: ${fail[*]}. See $DEST/errors.log on the VPS."
  exit 1
fi
rm -f "$DEST/errors.log"
echo "$(date -u +%FT%TZ) ok $DEST $(du -sh "$DEST" | cut -f1)"
