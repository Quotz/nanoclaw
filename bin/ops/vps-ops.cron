# VPS ops (source: nanoclaw repo bin/ops/, see README there).
CRON_TZ=Europe/Belgrade
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/10 * * * * root /usr/local/bin/health-check >> /var/log/health-check.log 2>&1
0 4 * * *    root /usr/local/bin/backup-all >> /var/log/backup-all.log 2>&1
0 3 * * 0    root /usr/local/bin/auto-update >> /var/log/auto-update.log 2>&1
