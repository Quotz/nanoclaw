<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nanoclaw.vps-backup-pull</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>-c</string><string>"$HOME/.local/bin/vps-pull-backups"</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/vps-backup-pull.log</string>
  <key>StandardErrorPath</key><string>/tmp/vps-backup-pull.log</string>
</dict>
</plist>
