#!/bin/bash
# Daily (cron). DMs once when a watched GitHub issue changes state or gets a new comment.
# Watch list: /etc/ops/watched-issues, one owner/repo#num per line. State: /var/lib/ops/issue-watch/<owner>_<repo>_<num>
# ("<state> <comment count>"). First sight is recorded silently; network/API errors stay silent (retried next run).
set -uo pipefail
S=/var/lib/ops/issue-watch; mkdir -p "$S"
gh(){ curl -fsS -m 20 -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$1"; }
grep -oE '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+' /etc/ops/watched-issues 2>/dev/null | while IFS='#' read -r repo num; do
  f=$S/${repo//\//_}_$num
  j=$(gh "$repo/issues/$num") || continue
  IFS=$'\t' read -r s1 n1 link who < <(python3 -c 'import sys,json;d=json.load(sys.stdin)
print(d["state"],d["comments"],d["html_url"],(d.get("closed_by") or {}).get("login",""),sep="\t")' <<<"$j") || continue
  [ -s "$f" ] || { echo "$s1 $n1" >"$f"; continue; }
  read -r s0 n0 <"$f"
  [ "$s1" = "$s0" ] && [ "$n1" -le "$n0" ] && { echo "$s1 $n1" >"$f"; continue; }
  what="new comment"; [ "$s1" != "$s0" ] && what=$s1; [ "$what" = open ] && what=reopened
  text=
  if [ "$n1" -gt "$n0" ]; then
    c=$(gh "$repo/issues/$num/comments?per_page=1&page=$n1") || continue   # page N of size 1 = latest comment
    IFS=$'\t' read -r who link text < <(python3 -c 'import sys,json;c=json.load(sys.stdin)[0]
print(c["user"]["login"],c["html_url"]," ".join(c["body"].split())[:300],sep="\t")' <<<"$c") || continue
  fi
  /usr/local/bin/matrix-dm "🐛 ${repo#*/}#$num $what: ${who:+$who: }${text:+$text }$link" >/dev/null && echo "$s1 $n1" >"$f"
done
