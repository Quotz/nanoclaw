#!/usr/bin/env python3
"""Send a plain-text Matrix message to the owner's Pero DM, as @pero.

  matrix-dm "text"        or        echo text | matrix-dm
"""
import json, sys, time, urllib.parse, urllib.request

ENV_FILE = "/opt/nanoclaw/.env"
DM_ROOM = "!FSSf1hJiBiS655TB:matrix.815431624.xyz"  # canonical owner<->pero DM

body = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
body = body.strip()[:30000]
if not body:
    sys.exit(0)
env = dict(l.split("=", 1) for l in open(ENV_FILE).read().splitlines() if "=" in l and not l.startswith("#"))
token = env["MATRIX_ACCESS_TOKEN"].strip("\"'")
base = env["MATRIX_BASE_URL"].strip("\"'").rstrip("/")
room = urllib.parse.quote(DM_ROOM, safe="")
req = urllib.request.Request(
    f"{base}/_matrix/client/v3/rooms/{room}/send/m.room.message/ops{time.time_ns()}", method="PUT",
    data=json.dumps({"msgtype": "m.text", "body": body}).encode(),
    headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
with urllib.request.urlopen(req, timeout=15) as r:
    print(f"matrix-dm http={r.status}")
